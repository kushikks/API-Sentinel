  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "serviceKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Sentinel-Service-Key"
      }
    },
    "schemas": {
      "MigrationSuggestions": {
        "type": "object",
        "properties": {
          "analysisId": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "type": "string",
            "const": "GEMINI"
          },
          "model": {
            "type": "string"
          },
          "verified": {
            "type": "boolean",
            "const": false
          },
          "eligibleFindingCount": {
            "type": "integer",
            "minimum": 1
          },
          "suggestions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "$ref": "#/components/schemas/MigrationSuggestion"
            }
          }
        },
        "required": [
          "analysisId",
          "source",
          "model",
          "verified",
          "eligibleFindingCount",
          "suggestions"
        ]
      },
      "MigrationSuggestion": {
        "type": "object",
        "properties": {
          "findingId": {
            "type": "string",
            "format": "uuid"
          },
          "severity": {
            "type": "string",
            "enum": [
              "BREAKING",
              "POTENTIALLY_BREAKING"
            ]
          },
          "category": {
            "type": "string"
          },
          "httpMethod": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "jsonPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "explanation": {
            "type": "string",
            "maxLength": 650
          },
          "affectedClientCode": {
            "type": "string",
            "maxLength": 650
          },
          "recommendedChanges": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string",
              "maxLength": 400
            }
          },
          "verificationSteps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string",
              "maxLength": 400
            }
          }
        },
        "required": [
          "findingId",
          "severity",
          "category",
          "httpMethod",
          "path",
          "jsonPath",
          "explanation",
          "affectedClientCode",
          "recommendedChanges",
          "verificationSteps"
        ]
      },
      "MigrationRateLimitProblem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Problem"
          },
          {
            "type": "object",
            "properties": {
              "retryAfterSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              }
            },
            "required": [
              "retryAfterSeconds"
            ]
          }
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "detail",
          "code"
        ]
      },
      "Status": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "QUEUED",
              "RUNNING",
              "RETRY_PENDING",
              "COMPLETED",
              "FAILED"
            ]
          },
          "attemptCount": {
            "type": "integer",
            "minimum": 0
          },
          "startedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "status",
          "attemptCount",
          "startedAt",
          "completedAt",
          "error"
        ]
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "apiId": {
            "type": "string",
