            "in": "query",
            "name": "apiId",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string",
              "enum": [
                "QUEUED",
                "RUNNING",
                "RETRY_PENDING",
                "COMPLETED",
                "FAILED"
              ]
            }
          },
          {
            "in": "query",
            "name": "page",
